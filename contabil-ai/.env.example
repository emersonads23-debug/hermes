# ============================================================
# ContabilAI - Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Server ---
NODE_ENV=production
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- JWT Authentication ---
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_64
JWT_EXPIRES_IN=7d

# --- Encryption ---
# Used for AES-256-GCM encryption of integration tokens at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_use_crypto_random_bytes_32_hex

# --- Supabase (PostgreSQL) ---
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Get from: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Redis (Queue System) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- OpenAI ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# --- Evolution API (WhatsApp) ---
# Docs: https://doc.evolution-api.com
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key-here
EVOLUTION_INSTANCE_NAME=contabil-ai
# Optional: HMAC secret for webhook signature validation
EVOLUTION_WEBHOOK_SECRET=

# --- Conta Azul (OAuth 2.0) ---
# Register app at: https://developers.contaazul.com
CONTA_AZUL_CLIENT_ID=your-client-id
CONTA_AZUL_CLIENT_SECRET=your-client-secret
CONTA_AZUL_REDIRECT_URI=http://localhost:3000/api/integrations/contaazul/callback

# --- Omie ERP ---
# Get credentials at: https://developer.omie.com.br/service-list/
OMIE_APP_KEY=your-app-key
OMIE_APP_SECRET=your-app-secret

# --- n8n Automation ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_USER=admin
N8N_PASSWORD=change-me-n8n-password

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=ContabilAI <noreply@contabilai.com>
ESCALATION_EMAIL=equipe@contabilai.com
ALERT_EMAIL_FROM=ContabilAI Alertas <alertas@contabilai.com>

# --- File Upload ---
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads

{
  "name": "ContabilAI - Connection Update",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "connection-update",
        "responseMode": "lastNode"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.state }}",
              "operation": "equals",
              "value2": "close"
            }
          ]
        }
      },
      "name": "Is Disconnected?",
      "type": "n8n-nodes-base.if",
      "position": [450, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $env.ESCALATION_EMAIL }}",
        "subject": "[ContabilAI] ALERTA: WhatsApp desconectado",
        "text": "A instancia WhatsApp do ContabilAI foi desconectada.\n\nInstancia: {{ $json.body.instance }}\nTimestamp: {{ $json.body.timestamp }}\n\nAcesse o painel do Evolution API para reconectar.",
        "options": {}
      },
      "name": "Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [650, 250],
      "typeVersion": 1
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "ok"
            }
          ]
        }
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.set",
      "position": [650, 400],
      "typeVersion": 1
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Is Disconnected?", "type": "main", "index": 0 }]
      ]
    },
    "Is Disconnected?": {
      "main": [
        [{ "node": "Alert Email", "type": "main", "index": 0 }],
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
